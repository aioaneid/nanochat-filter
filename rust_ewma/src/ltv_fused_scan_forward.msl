#include <metal_stdlib>
using namespace metal;

/**
 * FORWARD: h_t = (1 - alpha) * h_{t-1} + alpha * x_t
 * Optimized for strength reduction (no multiplications in loop)
 */

kernel void ltv_fused_scan_forward(
    device const float* x_q         [[buffer(0)]],
    device const float* x_k         [[buffer(1)]],
    device const float* x_v         [[buffer(2)]],
    device const float* logits      [[buffer(3)]], 
    device const float* inits       [[buffer(4)]],
    device float* out_q             [[buffer(5)]], 
    device float* out_k             [[buffer(6)]], 
    device float* out_v             [[buffer(7)]], 
    constant uint& B                [[buffer(8)]],
    constant uint& T                [[buffer(9)]],
    constant uint& NH               [[buffer(10)]],
    constant uint& NKVH             [[buffer(11)]],
    constant uint& Da               [[buffer(12)]], 
    constant uint& r                [[buffer(13)]], 
    uint3 id [[thread_position_in_grid]]
) {
    const uint b = id.x; 
    const uint h_glob = id.y; 
    const uint d = id.z;
    const uint D = Da * r;
    const uint total_h = NH + 2 * NKVH;
    
    // 1. Buffer steering logic
    device const float* x_in_base;
    device float* x_out_base;
    uint h_loc; 
    uint h_comp_total;

    if (h_glob < NH) { 
        x_in_base = x_q; x_out_base = out_q; h_loc = h_glob; h_comp_total = NH;
    } else if (h_glob < NH + NKVH) { 
        x_in_base = x_k; x_out_base = out_k; h_loc = h_glob - NH; h_comp_total = NKVH;
    } else { 
        x_in_base = x_v; x_out_base = out_v; h_loc = h_glob - (NH + NKVH); h_comp_total = NKVH;
    }

    // 2. Pre-calculate strides for t-increment
    const uint l_stride = total_h * Da;
    const uint in_stride = h_comp_total * D;
    const uint out_stride = D; // In (B, H, T, D), incrementing T moves by D

    // 3. Initial state pointer arithmetic
    const uint da_idx = d / r;

    // logits: (B, T, TotalH, Da)
    device const float* l_ptr = logits + (b * T * total_h * Da) + (h_glob * Da + da_idx);

    // x_in: (B, T, H, D)
    device const float* in_ptr = x_in_base + (b * T * h_comp_total * D) + (h_loc * D + d);
    
    // x_out: (B, H, T, D)
    device float* out_ptr = x_out_base + (b * h_comp_total * T * D) + (h_loc * T * D) + d;

    float acc = inits[b * (total_h * D) + h_glob * D + d];

    // 4. Optimized Loop
    for (uint t = 0; t < T; t++) {
        // Sigmoid gate
        float alpha = 1.0f / (1.0f + exp(-(*l_ptr)));
        
        // EMA update
        acc = (1.0f - alpha) * acc + alpha * (*in_ptr);
        
        // Fused Transpose Write
        *out_ptr = acc;

        // Pointer increments (Replaces all multiplications)
        l_ptr   += l_stride;
        in_ptr  += in_stride;
        out_ptr += out_stride;
    }
}
